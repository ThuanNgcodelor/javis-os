# MISA AMIS CRM Open API v2. Never commit the real secret.
AMIS_CLIENT_ID=JavisCFCChatbot
AMIS_CLIENT_SECRET=
AMIS_BASE_URL=https://crmconnect.misa.vn/api/v2

# Use the actual API field codes shown in AMIS Developer > API > Fields.
AMIS_PUBLIC_APPROVAL_FIELD=chatbot_public
AMIS_PUBLIC_PHONE_FIELD=chatbot_public_phone
AMIS_PUBLIC_ADDRESS_FIELD=chatbot_public_address

# Pilot-only alternative to the approval field. Comma-separated account numbers.
AMIS_PUBLIC_ACCOUNT_ALLOWLIST=

# Only recent, recorded and invoiced sales qualify a public sales location.
AMIS_PUBLIC_RECENCY_DAYS=365
AMIS_ALLOWED_REVENUE_STATUSES=Đã ghi
AMIS_BLOCKED_ORDER_STATUS_FRAGMENTS=Hủy,Từ chối

# Keep both false until the business explicitly approves these CRM fields for public use.
AMIS_ALLOW_BILLING_ADDRESS_FALLBACK=false
AMIS_ALLOW_OFFICE_PHONE_FALLBACK=false

# Optional shared token used by n8n when invoking the local sync endpoint.
AMIS_SYNC_INTERNAL_TOKEN=
